PORT=5000
NODE_ENV=development

# Hosted PostgreSQL providers usually supply this value.
DATABASE_URL=

# Local fallback values (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_tracker
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://kamva-hanisi.github.io
DB_AUTO_MIGRATE=true
